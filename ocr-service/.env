OCR_TESSERACT_CMD=D:\software\Tesseract-OCR\tesseract.exe
OCR_TESSDATA_PREFIX=D:\software\Tesseract-OCR\tessdata
OCR_OCR_LANGUAGE=chi_sim+eng
OCR_TESSERACT_CONFIG=--oem 3 --psm 6
