OCR_API_KEYS_FILE=..\API_keys.md
OCR_KIMI_API_KEY=
OCR_KIMI_BASE_URL=https://api.kimi.com/coding/v1
OCR_KIMI_FILE_BASE_URL=https://api.moonshot.cn/v1
